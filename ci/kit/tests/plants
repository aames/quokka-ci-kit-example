#!/usr/bin/env python3
"""THE PLANTED DEFECTS (kit/README.md §6.2, §6.1).

For each plant: copy the kit tree under test to a scratch directory, make ONE
edit to ONE file of the copy, run the plant's family against that copy
(KITT_KIT=<copy>) and require it to fail, printing the first failing line and
how many cases failed. The kit tree itself is never touched. Each edit's old
text must occur exactly once (or, for the by-rule edits, in the named block),
so a kit that has moved since this table was written fails here, loudly, not
by silently planting nothing.

  python3 kit/tests/plants [--only <id>]... [--bash <bash>] [--list]

Exit 0 when every plant turned its family red; 1 otherwise. KITT_KIT, if set,
is the tree planted from. Needs python3 and the host's bash 3.2 or later.
"""
import os, re, shutil, subprocess, sys, tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
KIT = os.environ.get("KITT_KIT") or os.path.dirname(HERE)


def once(old, new):
    def f(s):
        if s.count(old) != 1:
            raise SystemExit("plant text occurs %d times, not once: %r" % (s.count(old), old[:80]))
        return s.replace(old, new)
    return f


def append(text):
    return lambda s: s + text


def label(n):
    def f(s):
        if '"W-%d"' % n not in s:
            raise SystemExit("no label W-%d" % n)
        return s.replace('"W-%d"' % n, '"W-0"')
    return f


def chain(*edits):
    def f(s):
        for e in edits:
            s = e(s)
        return s
    return f


def lint_rule(n):
    def f(s):
        m = re.search(r"^# --- Rule %d\b.*$" % n, s, re.M)
        if not m:
            raise SystemExit("no Rule %d block" % n)
        nxt = re.search(r"^# --- Rule \d+", s[m.end():], re.M)
        end = m.end() + (nxt.start() if nxt else len(s) - m.end())
        block = s[m.end():end]
        new, k = re.subn(r"\bfinding0?\b(?= )", ":", block)
        if not k:
            raise SystemExit("Rule %d has no finding to remove" % n)
        return s[:m.end()] + new + s[end:]
    return f


