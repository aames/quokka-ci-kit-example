def main(argv):
    only, bash, listing = [], os.environ.get("BASH") or "/bin/bash", False
    i = 0
    while i < len(argv):
        if argv[i] == "--only": only.append(argv[i + 1]); i += 2
        elif argv[i] == "--bash": bash = argv[i + 1]; i += 2
        elif argv[i] == "--list": listing = True; i += 1
        else: raise SystemExit("usage: plants [--only id]... [--bash bash] [--list]")
    if listing:
        for pid, fam, file, _e, what in P: print(pid, fam, file, what)
        return 0
    bad = 0
    for pid, fam, file, edit, what in P:
        if only and pid not in only: continue
        scratch = tempfile.mkdtemp(prefix="cikit-lct-plant-")
        try:
            copy = os.path.join(scratch, "kit")
            shutil.copytree(KIT, copy, symlinks=True)
            path = os.path.join(copy, file)
            with open(path, encoding="utf-8") as fh: text = fh.read()
            new = edit(text)
            if new == text: raise SystemExit("plant %s changed nothing" % pid)
            with open(path, "w", encoding="utf-8") as fh: fh.write(new)
            if fam.startswith("IMAGE:"):
                cmd = [bash, os.path.join(copy, "tests", "image"), "--family", fam[6:]]
            else:
                cmd = [bash, os.path.join(copy, "tests", "run"), "--family", fam]
            env = dict(os.environ, KITT_KIT=copy, KITT_QUIET="1")
            try:
                r = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=600)
                fails = [l for l in r.stdout.splitlines() if l.startswith("FAIL:")]
                verdict = "RED" if r.returncode != 0 and fails else "NOT RED"
            except subprocess.TimeoutExpired:
                fails, verdict = ["FAIL: (the family did not finish in 600 s: a hang is not a pass)"], "RED"
            if verdict != "RED": bad += 1
            print("%-22s %-9s %-8s fails=%-3d | %s | %s" % (pid, fam, verdict, len(fails), what, (fails[0][:150] if fails else "(none)")), flush=True)
        finally:
            shutil.rmtree(scratch, ignore_errors=True)
    print("plants: %s" % ("all red" if not bad else "%d NOT RED" % bad))
    return 1 if bad else 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
