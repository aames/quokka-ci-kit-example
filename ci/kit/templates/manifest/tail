
# checks runs on every run; @@JOBS@@ run on a workstation (make check) or in
# CI; kit runs the vendored kit's own proofs.
job checks always-on
@@LINES_JOB@@
job kit local

# A job's key is a hash of these paths at the commit. `ci` holds the kit, this
# manifest, the adapter, the image and the signers file, so a change to any of
# them runs every job; each job image input outside a job's own directory is
# in that job's key too.
paths checks .
@@LINES_PATHS@@
paths kit ci

@@LINES_PIN@@
@@LINES_COUNT@@
count kit kit_cases
